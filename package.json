{
  "name": "fuel-me-japan",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "vite build && tsx scripts/prerender.tsx",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e",
    "deploy": "npm run check && wrangler pages deploy dist --project-name=fuel-me-japan --branch=main",
    "data:refresh": "python3 scripts/importer/pipeline.py refresh",
    "data:fetch-price": "python3 scripts/importer/pipeline.py fetch-price",
    "test:data": "python3 -m unittest discover -s tests/data -v",
    "data:quality": "tsx scripts/data-quality.ts"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/leaflet": "1.9.21",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.144.0"
  }
}
